# Server
PORT=4000
NODE_ENV=development

# Database
# Local MongoDB: install MongoDB Community Edition, then start as a single-node
# replica set so that transactions work:
#   mongod --replSet rs0
#   # in mongosh: rs.initiate()
# Default connection (no replica set, transactions disabled — not recommended):
#   MONGO_URI=mongodb://localhost:27017/brightloop
MONGO_URI=mongodb://localhost:27017/brightloop?replicaSet=rs0&directConnection=true

# Auth
JWT_SECRET=?oq,'kH5}\+hV8yKxTxWwSB^J-Pr0bpBIE($neSB|p|d5hv_KE.?n"k"!3737g7A
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# CORS
CLIENT_ORIGIN=http://localhost:5173

# Email (use Ethereal in dev: https://ethereal.email)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@brightloop.com
